# Environment variables for RAG chatbot with LangChain

# OpenAI API Key (Required if using OpenAI provider)
# Get your key at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Generative AI API Key (Required if using Google provider)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face Access Token (Required if using HuggingFace provider)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Cohere API Key (Required if using Cohere Reranker retriever)
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
